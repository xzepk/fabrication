  "limits": {"plates": 128, "quantityPerComponent": 1, "dimensionMM": 100000, "originMagnitudeMM": 10000000, "timeoutSeconds": 300, "stdoutBytes": 65536, "stderrBytes": 65536, "files": 1000, "singleFileBytes": 33554432, "totalFileBytes": 134217728},
  "ruleBindingFiles": ["capabilities.json", "request.schema.json", "run.py"],
  "reviewStatus": "REVIEW",
  "releaseDecision": "NOT_RELEASED",
  "manufacturingRelease": false,
  "arbitraryCode": false,
