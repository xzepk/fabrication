{
  "manifestVersion": 1,
  "skillId": "cladding-delivery",
  "skillVersion": "3.1.0",
  "adapterId": "rhino-cladding-planar",
  "adapterVersion": "1.0.0",
  "rulePolicy": "rhino-cladding-planar-v1",
  "inputSchema": "request.schema.json",
